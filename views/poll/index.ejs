<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <%- include('../partials/head') %>
  <style>
    .poll-hero {
      padding-top: 150px;
      padding-bottom: 80px;
      text-align: center;
      background: transparent;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .poll-card {
      background: var(--color-bg-surface);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      padding: 40px;
      max-width: 500px;
      width: 90%;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      transition: all 0.3s ease;
    }
    .poll-title {
      font-size: 2rem;
      font-weight: 700;
      color: var(--color-text-primary);
      margin-bottom: 20px;
    }
    .poll-btn {
      width: 100%;
      padding: 15px;
      font-size: 1.1rem;
      font-weight: 600;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s;
      margin-bottom: 15px;
      display: block;
      text-decoration: none;
      text-align: center;
    }
    .btn-primary {
      background: var(--color-primary);
      color: #fff;
    }
    .btn-primary:hover {
      background: var(--color-primary-dark);
    }
    .btn-outline {
      background: transparent;
      border: 2px solid var(--color-primary);
      color: var(--color-primary);
    }
    .btn-outline:hover {
      background: var(--color-primary);
      color: #fff;
    }
    .divider {
      margin: 20px 0;
      display: flex;
      align-items: center;
      color: var(--color-text-secondary);
      font-size: 0.9rem;
    }
    .divider::before, .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--color-border);
      margin: 0 15px;
    }
  </style>
</head>
<body>
  <%- include('../partials/dynamic-bg') %>
  <%- include('../partials/navbar') %>

  <section class="poll-hero">
    <div class="poll-card">
      <h1 class="poll-title">JAJAK PENDAPAT</h1>
      <p style="color: var(--color-text-secondary); margin-bottom: 30px;">
        Silakan pilih peran Anda dalam Jajak Pendapat ini.
      </p>

      <a href="/poll/join" class="poll-btn btn-primary">Join</a>

      <% 
        const _roleStr = (typeof userRole !== 'undefined' && userRole) ? String(userRole).trim().toLowerCase() : '';
        if (_roleStr === 'admin' || _roleStr === 'instruktur' || _roleStr === 'updl') { 
      %>
        <div class="divider">ATAU</div>
        <a href="/poll/create" class="poll-btn btn-outline">Host</a>
      <% } %>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
