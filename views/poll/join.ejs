<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <%- include('../partials/head') %>
  <style>
    .join-hero {
      padding-top: 150px;
      padding-bottom: 80px;
      text-align: center;
      background: var(--color-bg-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .join-card {
      background: var(--color-bg-surface);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      padding: 40px;
      max-width: 500px;
      width: 90%;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      transition: all 0.3s ease;
    }
    .join-title {
      font-size: 2rem;
      font-weight: 700;
      color: var(--color-text-primary);
      margin-bottom: 20px;
    }
    .join-input {
      width: 100%;
      padding: 15px 20px;
      font-size: 1.1rem;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: var(--color-bg-main);
      color: var(--color-text-primary);
      margin-bottom: 20px;
      text-align: center;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .btn-primary {
      width: 100%;
      padding: 15px;
      font-size: 1.1rem;
      font-weight: 600;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      background: var(--color-primary);
      color: #fff;
      transition: all 0.3s;
    }
    .btn-primary:hover {
      background: var(--color-primary-dark);
    }
  </style>
</head>
<body>
  <%- include('../partials/navbar') %>

  <section class="join-hero">
    <div class="join-card">
      <h1 class="join-title">JOIN JAJAK PENDAPAT</h1>
      <p style="color: var(--color-text-secondary); margin-bottom: 30px;">
        Masukkan kode PIN untuk bergabung. Anda akan tergabung secara anonim.
      </p>

      <form id="joinPollForm">
        <input type="text" id="pollCode" class="join-input" placeholder="KODE PIN" required maxlength="6">
        <button type="submit" class="btn-primary">Masuk Ruang Tunggu</button>
      </form>
    </div>
  </section>

  <%- include('../partials/footer') %>

  <script>
    document.getElementById('joinPollForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const code = document.getElementById('pollCode').value.trim().toUpperCase();
      if (code) {
        window.location.href = `/poll/take/${code}`;
      }
    });
  </script>
</body>
</html>
