<!-- views/admin/jadwal-instruktur.ejs -->

<div class="rd-page-head">
  <div class="rd-page-title-block">
    <div class="rd-page-eyebrow">Pembelajaran</div>
    <h1 class="rd-page-title">Jadwal Instruktur</h1>
    <p class="rd-page-subtitle">Kelola penjadwalan mengajar instruktur, mata pelajaran, dan durasi JP.</p>
  </div>
  <% if (currentUser && currentUser.role === 'UPDL') { %>
  <div class="rd-page-actions">
    <button class="rd-btn rd-btn-primary" onclick="openAddModal()">
      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Tambah Jadwal
    </button>
  </div>
  <% } %>
</div>

<div class="rd-data-card">
  <div class="rd-table-head" style="display:grid; grid-template-columns: 50px 1.5fr 1fr 1.5fr 1fr 1fr 100px <%= (currentUser && currentUser.role === 'UPDL') ? '120px' : '' %>; gap: 10px;">
    <span>No</span>
    <span>Nama Instruktur</span>
    <span>UPDL</span>
    <span>Mata Pelajaran</span>
    <span>Tgl Mulai</span>
    <span>Tgl Selesai</span>
    <span style="text-align:center;">Jumlah JP</span>
    <% if (currentUser && currentUser.role === 'UPDL') { %>
    <span style="text-align:center;">Aksi</span>
    <% } %>
  </div>

  <div id="jadwal-list">
    <% if (jadwalData && jadwalData.length > 0) { %>
      <% jadwalData.forEach((item, index) => { %>
        <div class="rd-table-row" style="display:grid; grid-template-columns: 50px 1.5fr 1fr 1.5fr 1fr 1fr 100px <%= (currentUser && currentUser.role === 'UPDL') ? '120px' : '' %>; gap: 10px; align-items:center; padding: 12px 16px; border-bottom: 1px solid var(--rd-border);">
          <span style="color: var(--rd-text-muted);"><%= index + 1 %></span>
          <span style="font-weight: 500; color: var(--rd-text-primary);">
            <%= item.katalog ? item.katalog.nama_instruktur : 'Unknown' %>
          </span>
          <span><%= item.updl %></span>
          <span><%= item.mata_pelajaran %></span>
          <span><%= new Date(item.tanggal_mulai).toLocaleDateString('id-ID', {day:'2-digit', month:'short', year:'numeric'}) %></span>
          <span><%= new Date(item.tanggal_selesai).toLocaleDateString('id-ID', {day:'2-digit', month:'short', year:'numeric'}) %></span>
          <span style="text-align:center; font-weight:600;"><%= item.jumlah_jp %> JP</span>
          <% if (currentUser && currentUser.role === 'UPDL') { %>
          <div style="display:flex; gap: 8px; justify-content:center;">
            <button class="rd-btn rd-btn-secondary rd-btn-sm btn-edit"
              data-id="<%= item.id %>"
              data-katalog-id="<%= item.katalog_id %>"
              data-updl="<%= item.updl %>"
              data-mapel="<%= item.mata_pelajaran %>"
              data-tgl-mulai="<%= item.tanggal_mulai %>"
              data-tgl-selesai="<%= item.tanggal_selesai %>"
              data-jp="<%= item.jumlah_jp %>">Edit</button>
            <button class="rd-btn rd-btn-secondary rd-btn-sm btn-hapus"
              style="color: var(--rd-error); border-color: #fee2e2; background: #fef2f2;"
              data-id="<%= item.id %>">Hapus</button>
          </div>
          <% } %>
        </div>
      <% }); %>
    <% } else { %>
      <div class="rd-empty" style="padding: 40px; text-align: center; color: var(--rd-text-muted);">
        <p>Belum ada data jadwal instruktur.</p>
      </div>
    <% } %>
  </div>
</div>

<% if (currentUser && currentUser.role === 'UPDL') { %>
<!-- Modal Tambah/Edit Jadwal -->
<div id="jadwalModal" class="rd-modal-overlay" style="display: none; justify-content: center; align-items: center; z-index: 1000;" onclick="if(event.target===this)closeModal()">
  <div class="rd-modal" style="max-width: 500px; width: 100%;">
    <div class="rd-modal-header">
      <div class="rd-modal-title-block">
        <h3 id="modalTitle" class="rd-page-title" style="font-size: 1.25rem;">Tambah Jadwal</h3>
      </div>
      <button type="button" onclick="closeModal()" class="rd-modal-close" style="background:none; border:none; font-size:1.5rem; cursor:pointer;">×</button>
    </div>
    <form id="jadwalForm" onsubmit="submitForm(event)">
      <div class="rd-modal-body" style="display:flex; flex-direction:column; gap:16px;">
        <input type="hidden" id="jadwalId">
        
        <div class="rd-field">
          <label>Pilih Instruktur</label>
          <select id="katalog_id" required class="rd-input">
            <option value="">-- Pilih Instruktur --</option>
            <% katalogData.forEach(k => { %>
              <option value="<%= k.id %>"><%= k.nama_instruktur %> (<%= k.nip %>)</option>
            <% }) %>
          </select>
        </div>
        
        <div class="rd-field">
          <label>UPDL</label>
          <input type="text" id="updl" required class="rd-input">
        </div>
        
        <div class="rd-field">
          <label>Mata Pelajaran</label>
          <input type="text" id="mata_pelajaran" required class="rd-input">
        </div>
        
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px;">
          <div class="rd-field">
            <label>Tanggal Mulai</label>
            <input type="date" id="tanggal_mulai" required class="rd-input">
          </div>
          <div class="rd-field">
            <label>Tanggal Selesai</label>
            <input type="date" id="tanggal_selesai" required class="rd-input">
          </div>
        </div>

        <div class="rd-field">
          <label>Jumlah JP</label>
          <input type="number" id="jumlah_jp" required class="rd-input">
        </div>
      </div>
      <div class="rd-modal-footer">
        <button type="button" class="rd-btn rd-btn-secondary" onclick="closeModal()">Batal</button>
        <button type="submit" class="rd-btn rd-btn-primary">Simpan</button>
      </div>
    </form>
  </div>
</div>

<script>
  const modal = document.getElementById('jadwalModal');
  const API_URL = '/api/pembelajaran/jadwal-instruktur';

  // Event delegation for Edit & Hapus buttons
  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('jadwal-list').addEventListener('click', (e) => {
      const editBtn = e.target.closest('.btn-edit');
      const hapusBtn = e.target.closest('.btn-hapus');

      if (editBtn) {
        const d = editBtn.dataset;
        editData(d.id, d.katalogId, d.updl, d.mapel, d.tglMulai, d.tglSelesai, d.jp);
      }
      if (hapusBtn) {
        deleteData(hapusBtn.dataset.id);
      }
    });
  });
  
  function openAddModal() {
    document.getElementById('modalTitle').textContent = 'Tambah Jadwal';
    document.getElementById('jadwalForm').reset();
    document.getElementById('jadwalId').value = '';
    modal.style.display = 'flex';
  }

  function editData(id, katalog_id, updl, mapel, tgl_mulai, tgl_selesai, jp) {
    document.getElementById('modalTitle').textContent = 'Edit Jadwal';
    document.getElementById('jadwalId').value = id;
    document.getElementById('katalog_id').value = katalog_id;
    document.getElementById('updl').value = updl;
    document.getElementById('mata_pelajaran').value = mapel;
    document.getElementById('tanggal_mulai').value = tgl_mulai.split('T')[0];
    document.getElementById('tanggal_selesai').value = tgl_selesai.split('T')[0];
    document.getElementById('jumlah_jp').value = jp;
    modal.style.display = 'flex';
  }

  function closeModal() {
    modal.style.display = 'none';
  }

  async function deleteData(id) {
    if (!confirm('Hapus jadwal ini?')) return;
    try {
      const res = await fetch(`${API_URL}/${id}`, {
        method: 'DELETE',
        credentials: 'include'
      });
      if (res.ok) window.location.reload();
      else {
        const err = await res.json();
        alert(err.error || 'Gagal menghapus data');
      }
    } catch (e) {
      alert('Terjadi kesalahan koneksi');
    }
  }

  async function submitForm(e) {
    e.preventDefault();
    const id = document.getElementById('jadwalId').value;
    const payload = {
      katalog_id: document.getElementById('katalog_id').value,
      updl: document.getElementById('updl').value,
      mata_pelajaran: document.getElementById('mata_pelajaran').value,
      tanggal_mulai: new Date(document.getElementById('tanggal_mulai').value).toISOString(),
      tanggal_selesai: new Date(document.getElementById('tanggal_selesai').value).toISOString(),
      jumlah_jp: parseInt(document.getElementById('jumlah_jp').value)
    };

    try {
      const res = await fetch(id ? `${API_URL}/${id}` : API_URL, {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(payload)
      });
      if (res.ok) {
        window.location.reload();
      } else {
        const err = await res.json();
        alert(err.error || 'Gagal menyimpan data');
      }
    } catch (err) {
      alert('Terjadi kesalahan koneksi');
    }
  }
</script>
<% } %>
