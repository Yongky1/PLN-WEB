<div class="rd-page-head">
    <div class="rd-page-title-block">
        <span class="rd-page-eyebrow">Pengaturan</span>
        <h1 class="rd-page-title">Background Dinamis</h1>
        <p class="rd-page-subtitle">Kelola background slideshow untuk halaman publik</p>
    </div>
    <div class="rd-page-actions">
        <button class="rd-btn rd-btn-primary" onclick="openUploadModal()">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Tambah Background
        </button>
    </div>
</div>

<div class="rd-container mt-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% if (backgrounds && backgrounds.length > 0) { %>
        <% backgrounds.forEach(function(bg) { %>
          <div class="rd-card p-4 relative group">
            <div class="w-full h-48 bg-gray-100 rounded-lg overflow-hidden mb-4 relative">
              <img src="<%= process.env.API_URL || 'http://localhost:4000' %><%= bg.file %>" alt="Background" class="w-full h-full object-cover">
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm text-gray-500"><%= new Date(bg.created_at).toLocaleDateString('id-ID') %></span>
              <button class="rd-btn rd-btn-danger rd-btn-sm" onclick="deleteBackground('<%= bg.id %>')">Hapus</button>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-full rd-card p-12 flex flex-col items-center justify-center text-center">
          <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <h3 class="text-lg font-semibold text-gray-800 mb-1">Belum ada background</h3>
          <p class="text-sm text-gray-500">Klik tombol Tambah Background untuk mengunggah gambar.</p>
        </div>
      <% } %>
    </div>
</div>

<!-- Upload Modal -->
<div id="upload-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeUploadModal()"></div>
  <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white rounded-xl shadow-2xl p-6">
    <div class="flex justify-between items-center mb-6">
      <h3 class="text-lg font-semibold brand-font text-gray-800">Upload Background Baru</h3>
      <button class="text-gray-400 hover:text-gray-600" onclick="closeUploadModal()">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form id="upload-form" onsubmit="handleUpload(event)">
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">Pilih Gambar</label>
        <input type="file" id="bg-file" name="file" accept="image/*" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" required>
        <p class="mt-2 text-xs text-gray-500">Format yang didukung: JPG, PNG, WEBP.</p>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <button type="button" class="rd-btn" style="background:var(--rd-surface-hover); color:var(--rd-text-secondary);" onclick="closeUploadModal()">Batal</button>
        <button type="submit" class="rd-btn rd-btn-primary" id="btn-submit">
          <span>Upload</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openUploadModal() {
    document.getElementById('upload-modal').classList.remove('hidden');
  }

  function closeUploadModal() {
    document.getElementById('upload-modal').classList.add('hidden');
    document.getElementById('upload-form').reset();
  }

  async function handleUpload(e) {
    e.preventDefault();
    const btn = document.getElementById('btn-submit');
    const fileInput = document.getElementById('bg-file');
    
    if (!fileInput.files[0]) return;

    btn.disabled = true;
    btn.innerHTML = '<svg class="w-4 h-4 mr-2 animate-spin" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Mengunggah...';

    const formData = new FormData();
    formData.append('file', fileInput.files[0]);

    try {
      await fetchBackend('/api/backgrounds', {
        method: 'POST',
        body: formData
      });
      window.location.reload();
    } catch (err) {
      alert(err.message || 'Terjadi kesalahan');
      btn.disabled = false;
      btn.innerHTML = 'Upload';
    }
  }

  async function deleteBackground(id) {
    if (!confirm('Apakah Anda yakin ingin menghapus background ini?')) return;
    try {
      await fetchBackend(`/api/backgrounds/${id}`, { method: 'DELETE' });
      window.location.reload();
    } catch (err) {
      alert(err.message || 'Terjadi kesalahan saat menghapus');
    }
  }
</script>
