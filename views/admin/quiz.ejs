<div class="rd-page-head">
  <div class="rd-page-title-block">
    <span class="rd-page-eyebrow">Manajemen Modul</span>
    <h1 class="rd-page-title">Data Kuis</h1>
    <p class="rd-page-subtitle">Manajemen Kuis dan Hasil Peserta</p>
  </div>
</div>

<!-- BAGIAN 1: KUIS YANG DIBUAT -->
<div class="rd-card" style="margin-bottom: 30px;">
  <div class="rd-card-header">
    <h3 class="rd-card-title">1. Kuis yang Telah Dibuat</h3>
  </div>
  <div class="rd-card-body">
    <% if (quizzes && quizzes.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <% quizzes.forEach((quiz, index) => { %>
          <div style="border: 1px solid var(--color-border); border-radius: 12px; padding: 20px; background: var(--color-bg-main);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
              <div>
                <h4 style="margin: 0; font-size: 1.2rem; color: var(--color-primary);"><%= index + 1 %>. <%= quiz.title %></h4>
                <p style="margin: 5px 0 0 0; color: var(--color-text-secondary); font-size: 0.9rem;">
                  Dibuat pada: <%= new Date(quiz.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </p>
              </div>
              <div style="text-align: right;">
                <span style="font-size: 0.9rem; color: var(--color-text-secondary); display: block; margin-bottom: 5px;">Kode Unik Kuis:</span>
                <span style="letter-spacing: 3px; font-weight: bold; font-size: 1.1rem; background: var(--color-bg-surface); padding: 5px 10px; border-radius: 6px; border: 1px solid var(--color-border);">
                  <%= quiz.code %>
                </span>
              </div>
            </div>

            <!-- Detail Soal dan Kunci Jawaban -->
            <details style="margin-bottom: 10px; background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 8px;">
              <summary style="padding: 15px; font-weight: 600; cursor: pointer; outline: none;">
                Lihat Soal & Kunci Jawaban (<%= quiz.questions ? quiz.questions.length : 0 %> Soal)
              </summary>
              <div style="padding: 0 15px 15px 15px; border-top: 1px solid var(--color-border);">
                <% if (quiz.questions && quiz.questions.length > 0) { %>
                  <% quiz.questions.forEach((q, qIdx) => { %>
                    <div style="margin-top: 15px; padding: 15px; background: var(--color-bg-main); border-radius: 8px;">
                      <div style="font-weight: 600; margin-bottom: 10px;"><%= qIdx + 1 %>. <%= q.text %> <span style="font-size: 0.85em; font-weight: normal; color: var(--color-text-secondary);">(Tipe: <%= q.type %>)</span></div>
                      <ul style="list-style: none; padding-left: 0; margin: 0;">
                        <% if (q.options && q.options.length > 0) { %>
                          <% q.options.forEach(opt => { %>
                            <li style="margin-bottom: 5px; <%= opt.is_correct ? 'font-weight: bold; color: var(--color-success);' : 'color: var(--color-text-secondary);' %>">
                              <%= opt.is_correct ? '✅' : '❌' %> <%= opt.text %>
                            </li>
                          <% }) %>
                        <% } else { %>
                          <li style="color: var(--color-text-secondary); font-style: italic;">Jawaban berupa teks (Essay bebas)</li>
                        <% } %>
                      </ul>
                    </div>
                  <% }) %>
                <% } else { %>
                  <p style="color: var(--color-text-secondary); margin-top: 15px;">Belum ada soal pada kuis ini.</p>
                <% } %>
              </div>
            </details>

            <!-- Detail Peserta dan Nilai -->
            <details style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 8px;">
              <summary style="padding: 15px; font-weight: 600; cursor: pointer; outline: none;">
                Lihat Peserta & Nilai Kuis (<%= quiz.submissions ? quiz.submissions.length : 0 %> Peserta)
              </summary>
              <div style="padding: 0 15px 15px 15px; border-top: 1px solid var(--color-border);">
                <% if (quiz.submissions && quiz.submissions.length > 0) { %>
                  <div class="table-responsive" style="margin-top: 15px;">
                    <table class="rd-table">
                      <thead>
                        <tr>
                          <th>No</th>
                          <th>Nama Peserta</th>
                          <th>Nilai</th>
                          <th>Waktu Mengerjakan</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% quiz.submissions.forEach((sub, sIdx) => { %>
                          <% 
                            let scoreColor = 'var(--color-error)';
                            if (sub.score >= 80) scoreColor = 'var(--color-success)';
                            else if (sub.score >= 50) scoreColor = 'var(--color-warning)';
                          %>
                          <tr>
                            <td><%= sIdx + 1 %></td>
                            <td><strong><%= sub.participant_name %></strong></td>
                            <td><strong style="color: <%= scoreColor %>"><%= Math.round(sub.score) %></strong> / 100</td>
                            <td><%= new Date(sub.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } else { %>
                  <p style="color: var(--color-text-secondary); margin-top: 15px;">Belum ada peserta yang mengerjakan kuis ini.</p>
                <% } %>
              </div>
            </details>

          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align: center; color: var(--color-text-secondary); padding: 40px;">
        Belum ada kuis yang dibuat.
      </div>
    <% } %>
  </div>
</div>

<!-- BAGIAN 2: KUIS YANG PERNAH DIKERJAKAN -->
<div class="rd-card">
  <div class="rd-card-header">
    <h3 class="rd-card-title">2. Kuis yang Pernah Dikerjakan Beserta Nilainya</h3>
  </div>
  <div class="rd-card-body p-0">
    <div class="table-responsive">
      <table class="rd-table">
        <thead>
          <tr>
            <th>No</th>
            <th>Nama Peserta</th>
            <th>Judul Kuis (Kode)</th>
            <th>Nilai Akhir</th>
            <th>Waktu Submit</th>
          </tr>
        </thead>
        <tbody>
          <% if (allSubmissions && allSubmissions.length > 0) { %>
            <% allSubmissions.forEach((sub, idx) => { %>
              <% 
                let scoreColor = 'var(--color-error)';
                if (sub.score >= 80) scoreColor = 'var(--color-success)';
                else if (sub.score >= 50) scoreColor = 'var(--color-warning)';
              %>
              <tr>
                <td><%= idx + 1 %></td>
                <td><strong><%= sub.participant_name %></strong></td>
                <td>
                  <%= sub.quiz.title %> 
                  <span style="color: var(--color-text-secondary); font-size: 0.9em; background: var(--color-bg-surface-alt); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--color-border); margin-left: 5px;">
                    <%= sub.quiz.code %>
                  </span>
                </td>
                <td><strong style="color: <%= scoreColor %>"><%= Math.round(sub.score) %></strong> / 100</td>
                <td><%= new Date(sub.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" style="text-align: center; color: var(--color-text-secondary); padding: 40px;">Belum ada peserta yang mengerjakan kuis apapun.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary::after {
    content: '▼';
    float: right;
    font-size: 0.8em;
    transition: transform 0.3s;
  }
  details[open] > summary::after {
    transform: rotate(180deg);
  }
</style>
