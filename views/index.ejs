<!DOCTYPE html>
<html lang="id">

<head>
  <%- include('partials/head') %>
</head>

<body class="landing-page">

  <!-- ListrikPedia Premium Loader -->
  <div id="jala-loader" style="position: fixed; inset: 0; background: #ffffff; z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);">
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 2rem;">
      <!-- Glowing Bolt Icon -->
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="animation: pulse-glow 2s infinite ease-in-out;">
        <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" fill="url(#paint0_linear)" stroke="#0ea5e9" stroke-width="1.5" stroke-linejoin="round"/>
        <defs>
          <linearGradient id="paint0_linear" x1="12" y1="2" x2="12" y2="22" gradientUnits="userSpaceOnUse">
            <stop stop-color="#38bdf8"/>
            <stop offset="1" stop-color="#0284c7"/>
          </linearGradient>
        </defs>
      </svg>
      <!-- Premium Text -->
      <h2 style="font-family: 'Inter', sans-serif; font-weight: 800; font-size: 32px; letter-spacing: -0.05em; background: linear-gradient(135deg, #0f172a 0%, #334155 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin: 0;">
        Listrik<span style="color: #0ea5e9; -webkit-text-fill-color: #0ea5e9;">Pedia</span>
      </h2>
    </div>
    
    <!-- Animated Progress Bar -->
    <div style="width: 260px; height: 4px; background: #f1f5f9; border-radius: 4px; overflow: hidden; position: relative; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);">
      <div style="width: 100%; height: 100%; background: linear-gradient(90deg, #38bdf8, #2563eb, #38bdf8); background-size: 200% 100%; border-radius: 4px; animation: load-progress 1.5s cubic-bezier(0.4, 0, 0.2, 1) infinite, gradient-shift 2s linear infinite; transform-origin: left;"></div>
    </div>
    
    <!-- Subtitle -->
    <p style="margin-top: 1.25rem; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; color: #64748b; letter-spacing: 0.1em; text-transform: uppercase; animation: pulse-opacity 1.5s infinite ease-in-out;">
      Memuat Ekosistem PLN
    </p>

    <!-- Inline Styles for Loader Animations -->
    <style>
      @keyframes pulse-glow { 
        0%, 100% { filter: drop-shadow(0 0 8px rgba(14, 165, 233, 0.3)); transform: scale(1); } 
        50% { filter: drop-shadow(0 0 20px rgba(14, 165, 233, 0.6)); transform: scale(1.05); } 
      }
      @keyframes pulse-opacity { 
        0%, 100% { opacity: 0.4; } 
        50% { opacity: 1; } 
      }
      @keyframes load-progress { 
        0% { transform: translateX(-100%); } 
        100% { transform: translateX(100%); } 
      }
      @keyframes gradient-shift {
        0% { background-position: 100% 0; }
        100% { background-position: -100% 0; }
      }
    </style>
  </div>

  <!-- Importmap untuk Three.js (sama seperti halaman 3D lain) -->
  <script type="importmap">
  {
    "imports": {
      "three": "/scripts/three/three.module.js",
      "three/addons/": "/scripts/three/jsm/"
    }
  }
  </script>

  <!-- Scroll 3D Background (model GLB di-scrub oleh scroll) -->
  <div id="scroll-video-container">
    <!-- Gradient placeholder (tampil saat model loading / fallback bila WebGL gagal) -->
    <div class="video-placeholder"></div>
    <div class="ambient-mesh"></div>
    <canvas id="hero-3d-canvas"></canvas>
    <div class="overlay"></div>
  </div>

  <!-- Particles -->
  <canvas id="particles-canvas"></canvas>

  <!-- Fixed Cards Overlay -->
  <%- include('partials/categories') %>

  <!-- Navigation -->
  <%- include('partials/navbar') %>

  <!-- Main Content -->
  <div id="content">
    <!-- Section 1: Hero -->
    <%- include('partials/hero') %>

    <!-- Spacer for scroll video -->
    <div style="height:150vh;"></div>

    <!-- Cards Trigger Zone -->
    <%- include('partials/intro') %>

    <!-- Spacer -->
    <div style="height:100vh;"></div>

    <!-- Section 3: Brand Reveal -->
    <%- include('partials/showcase') %>

    <!-- Footer (minimal) -->
    <%- include('partials/footer') %>
  </div>

  <!-- Landing Page JS -->
  <script src="/js/landing.js"></script>
  <!-- Hero Typewriter -->
  <script src="/js/hero-interactions.js"></script>
  <!-- Hero 3D scroll engine (model GLB) -->
  <script type="module" src="/js/hero-3d.js"></script>
</body>

</html>