<!DOCTYPE html>
<html lang="id" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head') %>
    <style>
      /* Switch Styles */
      .switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
      }
      .switch input { 
        opacity: 0;
        width: 0;
        height: 0;
      }
      .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--color-error, #EF4444);
        transition: .4s;
        border-radius: 24px;
      }
      .slider:before {
        position: absolute;
        content: '';
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
      }
      input:checked + .slider {
        background-color: var(--color-success, #10B981) !important;
      }
      input:focus + .slider {
        box-shadow: 0 0 1px var(--color-success, #10B981);
      }
      input:checked + .slider:before {
        transform: translateX(20px);
      }
    </style>
</head>
<body class="antialiased" style="background-color: var(--color-bg-main); color: var(--color-text-primary);">
    <%- include('../partials/dynamic-bg') %>
    <%- include('../partials/navbar') %>

    <main style="padding-top:120px; padding-bottom:64px; min-height:100vh;" class="relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Header -->
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-10 pb-8 relative">
                <div class="gsap-reveal bg-contrast-text">
                    <div class="mb-2">
                        <span class="text-sm font-semibold tracking-widest text-[var(--color-primary)] uppercase">PEMBELAJARAN</span>
                    </div>
                    <h1 class="text-4xl md:text-5xl font-extrabold brand-font mb-3 tracking-tight leading-tight text-[var(--color-text-primary)]">
                        Data Kuis
                    </h1>
                    <p class="text-lg text-[var(--color-text-secondary)]">Manajemen kuis dan lihat hasil dari peserta.</p>
                </div>
            </div>
        </div>

        <div class="w-full bg-[var(--color-bg-main)] relative z-10" style="min-height: 100vh; padding-bottom: 64px;">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">

              <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] overflow-hidden shadow-sm">
                <div class="overflow-x-auto">
                  <table class="w-full text-left border-collapse">
                    <thead>
                      <tr class="bg-[var(--color-bg-hover)] border-b border-[var(--color-border)]">
                        <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">Judul Kuis</th>
                        <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">Kode</th>
                        <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm text-center">Jumlah Soal</th>
                        <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm text-center">Peserta</th>
                        <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">Dibuat Pada</th>
                        <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm text-center">Status</th>
                        <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm text-center">Aksi</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (quizzes && quizzes.length > 0) { %>
                        <% quizzes.forEach(quiz => { %>
                          <tr class="border-b border-[var(--color-border)] hover:bg-[var(--color-bg-hover)] transition-colors">
                            <td class="p-4 font-medium text-[var(--color-text-primary)]"><%= quiz.title %></td>
                            <td class="p-4">
                              <span style="letter-spacing: 2px; background: #F3F4F6; color: #374151; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 600;"><%= quiz.code %></span>
                            </td>
                            <td class="p-4 text-center text-[var(--color-text-primary)]"><%= quiz.questions ? quiz.questions.length : 0 %></td>
                            <td class="p-4 text-center text-[var(--color-text-primary)]"><%= quiz.submissions ? quiz.submissions.length : 0 %></td>
                            <td class="p-4 text-[var(--color-text-muted)] text-sm"><%= new Date(quiz.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                            <td class="p-4">
                              <div style="display: flex; justify-content: center; align-items: center;">
                                <label class="switch">
                                  <input type="checkbox" onchange="toggleQuizStatus('<%= quiz.code %>', this.checked)" <%= quiz.is_active ? 'checked' : '' %>>
                                  <span class="slider round"></span>
                                </label>
                              </div>
                            </td>
                            <td class="p-4">
                              <div class="flex gap-2 justify-center">
                                <a href="/quiz/host/<%= quiz.code %>" target="_blank" class="px-3 py-1.5 bg-green-50 text-green-600 border border-green-200 rounded-md hover:bg-green-600 hover:text-white transition-colors text-sm font-medium">Host Kuis</a>
                                <button class="px-3 py-1.5 bg-blue-50 text-blue-600 border border-blue-200 rounded-md hover:bg-blue-600 hover:text-white transition-colors text-sm font-medium" onclick="showQuizCombined('<%= quiz.id %>')">Detail & Hasil</button>
                                <button type="button" class="px-3 py-1.5 bg-red-50 text-red-600 border border-red-200 rounded-md hover:bg-red-600 hover:text-white transition-colors text-sm font-medium" onclick="deleteQuizAction('<%= quiz.id %>')" title="Hapus Kuis">
                                  <svg style="pointer-events:none; display:block;" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                </button>
                                <script>
                                  window['quiz_<%= quiz.id %>'] = <%- JSON.stringify(quiz.submissions) %>;
                                  window['quiz_title_<%= quiz.id %>'] = "<%= quiz.title %>";
                                  window['quiz_data_<%= quiz.id %>'] = <%- JSON.stringify(quiz) %>;
                                </script>
                              </div>
                            </td>
                          </tr>
                        <% }) %>
                      <% } else { %>
                        <tr>
                          <td colspan="7" class="p-8 text-center text-[var(--color-text-muted)]">
                            Belum ada kuis yang dibuat.
                          </td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>

              <!-- Inline Card Detail & Hasil Kuis -->
              <div class="fixed inset-0 z-[200] hidden items-center justify-center bg-black/50 backdrop-blur-sm transition-opacity" id="combinedModal">
                  <div class="bg-white rounded-xl shadow-2xl w-full max-w-4xl overflow-hidden transform transition-transform my-8 flex flex-col max-h-[90vh]">
                    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                      <h3 class="text-lg font-bold text-gray-800" id="combinedQuizTitle">Detail & Hasil Kuis</h3>
                      <button class="text-gray-400 hover:text-gray-600 transition-colors" onclick="closeModal('combinedModal')">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                      </button>
                    </div>
                    <div class="px-6 py-4 overflow-y-auto flex-1">
                      
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
                        <!-- Kiri: Detail Soal -->
                        <div>
                          <h4 class="mb-4 border-b border-gray-200 pb-2 text-gray-800 font-semibold">Detail Soal</h4>
                          <div id="combinedDetailsBody">
                            <!-- Injected via JS -->
                          </div>
                        </div>
                        
                        <!-- Kanan: Papan Peringkat -->
                        <div>
                          <h4 class="mb-4 border-b border-gray-200 pb-2 text-gray-800 font-semibold">Papan Peringkat (Top 3)</h4>
                          <div id="combinedSubmissionsBody" class="flex flex-col gap-3">
                            <!-- Injected via JS -->
                          </div>
                        </div>
                      </div>
                      
                    </div>
                  </div>
              </div>

            </div>
        </div>
    </main>
    <script>
      function showQuizCombined(quizId) {
        const quiz = window[`quiz_data_${quizId}`];
        const submissions = window[`quiz_${quizId}`];
        const title = window[`quiz_title_${quizId}`];
        
        document.getElementById('combinedQuizTitle').textContent = `Detail & Hasil: ${title}`;
        
        const detailsBody = document.getElementById('combinedDetailsBody');
        let html = `
          <div class="mb-5 p-4 bg-gray-50 rounded-lg">
            <strong>Kode Akses Kuis:</strong> <span class="font-mono text-lg bg-white px-2 py-1 rounded ml-2">${quiz.code}</span>
          </div>
        `;

        if (quiz.questions && quiz.questions.length > 0) {
          quiz.questions.forEach((q, idx) => {
            html += `
              <div class="border border-gray-200 p-4 rounded-lg mb-4">
                <div class="font-semibold mb-2 text-gray-800">${idx + 1}. ${q.text} <span class="text-gray-500 font-normal text-sm">(${q.type})</span></div>
                <ul class="list-none p-0 m-0">
            `;
            
            if (q.options && q.options.length > 0) {
              q.options.forEach(opt => {
                const isCorrect = opt.is_correct;
                const icon = isCorrect ? '<span class="text-green-500">✅</span>' : '<span class="text-red-500">❌</span>';
                const style = isCorrect ? 'font-semibold text-green-600' : 'text-gray-500';
                html += `<li class="mb-1 ${style}">${icon} ${opt.text}</li>`;
              });
            } else {
              html += `<li class="text-gray-500 italic">Tidak ada opsi (Essay bebas)</li>`;
            }

            html += `</ul></div>`;
          });
        } else {
          html += `<p class="text-gray-500">Kuis ini belum memiliki soal.</p>`;
        }

        detailsBody.innerHTML = html;

        const tbody = document.getElementById('combinedSubmissionsBody');
        tbody.innerHTML = '';

        let sortedSubmissions = [];
        if (submissions && submissions.length > 0) {
          sortedSubmissions = [...submissions].sort((a, b) => {
            if (b.score !== a.score) {
              return b.score - a.score;
            }
            return new Date(a.created_at) - new Date(b.created_at);
          });
        }

        if (sortedSubmissions.length > 0) {
          sortedSubmissions.forEach((sub, index) => {
            const row = document.createElement('div');
            const date = new Date(sub.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
            
            let bgClass = 'bg-white';
            let borderClass = 'border border-gray-200';
            let medalIcon = '';
            let rankColor = 'text-gray-500';

            if (index === 0) {
              bgClass = 'bg-gradient-to-br from-yellow-50 to-yellow-100';
              borderClass = 'border border-yellow-300 border-l-4 border-l-yellow-500';
              medalIcon = '🥇';
              rankColor = 'text-yellow-600';
            } else if (index === 1) {
              bgClass = 'bg-gradient-to-br from-gray-50 to-gray-100';
              borderClass = 'border border-gray-200 border-l-4 border-l-gray-400';
              medalIcon = '🥈';
              rankColor = 'text-gray-500';
            } else if (index === 2) {
              bgClass = 'bg-gradient-to-br from-orange-50 to-orange-100';
              borderClass = 'border border-orange-200 border-l-4 border-l-orange-500';
              medalIcon = '🥉';
              rankColor = 'text-orange-700';
            } else {
              borderClass = 'border border-gray-200 border-l-4 border-l-transparent';
            }

            row.className = `flex items-center gap-3 p-3 rounded-lg ${bgClass} ${borderClass}`;
            
            let scoreColor = 'text-red-500';
            if (sub.score >= 80) scoreColor = 'text-green-500';
            else if (sub.score >= 50) scoreColor = 'text-yellow-500';

            row.innerHTML = `
              <div class="text-lg font-bold ${rankColor} w-8 text-center">
                ${medalIcon ? medalIcon : (index + 1)}
              </div>
              <div class="flex-1 min-w-0">
                <div class="font-semibold text-gray-800 truncate">${sub.participant_name}</div>
                <div class="text-xs text-gray-500">${date}</div>
              </div>
              <div class="text-right">
                <div class="font-bold text-lg ${scoreColor}">${Math.round(sub.score)}</div>
                <div class="text-[10px] text-gray-400 font-semibold">SKOR</div>
              </div>
            `;
            tbody.appendChild(row);
          });
        } else {
          tbody.innerHTML = `<div class="text-center text-gray-500 p-8 bg-gray-50 rounded-lg">Belum ada peserta yang mengerjakan kuis ini.</div>`;
        }

        const modal = document.getElementById('combinedModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }

      function closeModal(id) {
        const modal = document.getElementById(id);
        modal.classList.remove('flex');
        modal.classList.add('hidden');
      }

      async function toggleQuizStatus(code, isActive) {
        try {
          const response = await fetch(`/api/quiz/${code}/toggle-status`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json'
            },
            credentials: 'same-origin',
            body: JSON.stringify({ is_active: isActive })
          });

          const data = await response.json();
          
          if (!response.ok) {
            throw new Error(data.error || 'Gagal mengubah status quiz');
          }

          alert(`Status quiz berhasil diubah menjadi ${isActive ? 'Aktif' : 'Tidak Aktif'}.`);
        } catch (error) {
          console.error('Error toggling quiz status:', error);
          alert('Gagal: ' + error.message);
          // Revert the toggle switch visually
          setTimeout(() => location.reload(), 500);
        }
      }

      async function deleteQuizAction(id) {
        if (!id) return;
        
        try {
          const response = await fetch(`/api/quiz/${id}`, {
            method: 'DELETE',
            credentials: 'same-origin'
          });
          
          if (!response.ok) {
            let errorMsg = 'Gagal menghapus kuis';
            try {
              const data = await response.json();
              errorMsg = data.error || errorMsg;
            } catch(err) {}
            throw new Error(errorMsg);
          }

          window.location.reload();
        } catch (error) {
          console.error('Delete Quiz Error:', error);
          alert('Gagal: ' + (error.message || 'Terjadi kesalahan sistem.'));
        }
      }
    </script>
    <%- include('../partials/footer') %>
</body>
</html>
