<div class="rd-page-head" style="margin-bottom: 24px;">
  <div class="rd-page-title-block">
    <span class="rd-page-eyebrow">PEMBELAJARAN</span>
    <h1 class="rd-page-title">Data Kuis</h1>
    <p class="rd-page-subtitle">Manajemen kuis dan lihat hasil dari peserta.</p>
  </div>
</div>


<!-- KUIS YANG DIBUAT (TAB 1) -->
<div class="rd-data-card" id="view-created">
  <div class="rd-table-head" style="display:grid; grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr 1fr 1.5fr; gap: 10px;">
    <span>Judul Kuis</span>
    <span>Kode</span>
    <span style="text-align:center;">Jumlah Soal</span>
    <span style="text-align:center;">Peserta</span>
    <span>Dibuat Pada</span>
    <span style="text-align:center;">Status</span>
    <span style="text-align:center;">Aksi</span>
  </div>
  <div id="created-list">
    <% if (quizzes && quizzes.length > 0) { %>
      <% quizzes.forEach(quiz => { %>
        <div class="rd-table-row" style="display:grid; grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr 1fr 1.5fr; gap: 10px; align-items:center; padding: 12px 16px; border-bottom: 1px solid var(--rd-border);">
          <span style="font-weight: 500; color: var(--rd-text-primary);"><%= quiz.title %></span>
          <span><span style="letter-spacing: 2px; background: #F3F4F6; color: #374151; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 600;"><%= quiz.code %></span></span>
          <span style="text-align:center;"><%= quiz.questions ? quiz.questions.length : 0 %></span>
          <span style="text-align:center;"><%= quiz.submissions ? quiz.submissions.length : 0 %></span>
          <span style="color: var(--rd-text-secondary); font-size: 13px;"><%= new Date(quiz.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
          <div style="text-align:center; display: flex; justify-content: center; align-items: center;">
            <label class="switch" style="position: relative; display: inline-block; width: 44px; height: 24px;">
              <input type="checkbox" onchange="toggleQuizStatus('<%= quiz.code %>', this.checked)" <%= quiz.is_active ? 'checked' : '' %> style="opacity: 0; width: 0; height: 0;">
              <span class="slider round" style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--color-error, #EF4444); transition: .4s; border-radius: 24px;"></span>
              <style>
                input:checked + .slider { background-color: var(--color-success, #10B981) !important; }
                input:focus + .slider { box-shadow: 0 0 1px var(--color-success, #10B981); }
                .slider:before { position: absolute; content: ''; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%; }
                input:checked + .slider:before { transform: translateX(20px); }
              </style>
            </label>
          </div>
          <div style="display:flex; gap: 6px; justify-content:center;">
            <a href="/quiz/host/<%= quiz.code %>" target="_blank" class="rd-btn rd-btn-primary rd-btn-sm" style="background: var(--color-success, #10B981); border-color: var(--color-success, #10B981);">Host Kuis</a>
            <button class="rd-btn rd-btn-primary rd-btn-sm" onclick="showQuizCombined('<%= quiz.id %>')">Detail & Hasil</button>
            <button type="button" class="rd-btn rd-btn-primary rd-btn-sm btn-delete-quiz-action" data-quiz-id="<%= quiz.id %>" style="padding: 6px 10px; background: var(--color-error, #EF4444); border-color: var(--color-error, #EF4444);" title="Hapus Kuis">
              <svg style="pointer-events:none; display:block;" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </button>
            <script>
              window['quiz_<%= quiz.id %>'] = <%- JSON.stringify(quiz.submissions) %>;
              window['quiz_title_<%= quiz.id %>'] = "<%= quiz.title %>";
              window['quiz_data_<%= quiz.id %>'] = <%- JSON.stringify(quiz) %>;
            </script>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="rd-empty" style="padding: 40px; text-align: center; color: var(--rd-text-muted);">
        <p>Belum ada kuis yang dibuat.</p>
      </div>
    <% } %>
  </div>
</div>


<!-- Inline Card Detail & Hasil Kuis -->
<div class="rd-modal" id="combinedModal" style="display: none; max-width: 100%; width: 100%; margin: 24px auto 0 auto; margin-bottom: 40px;">
    <div class="rd-modal-header">
      <h3 class="rd-modal-title" id="combinedQuizTitle">Detail & Hasil Kuis</h3>
      <button class="rd-modal-close" onclick="closeModal('combinedModal')">×</button>
    </div>
    <div class="rd-modal-body" style="max-height: 70vh; overflow-y: auto;">
      
      <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 30px; align-items: flex-start;">
        <!-- Kiri: Detail Soal -->
        <div>
          <h4 style="margin-bottom: 15px; border-bottom: 1px solid var(--rd-border); padding-bottom: 8px; color: var(--text-primary);">Detail Soal</h4>
          <div id="combinedDetailsBody">
            <!-- Injected via JS -->
          </div>
        </div>
        
        <!-- Kanan: Papan Peringkat -->
        <div>
          <h4 style="margin-bottom: 15px; border-bottom: 1px solid var(--rd-border); padding-bottom: 8px; color: var(--text-primary);">Papan Peringkat (Top 3)</h4>
          <div id="combinedSubmissionsBody" style="display: flex; flex-direction: column; gap: 10px;">
            <!-- Injected via JS -->
          </div>
        </div>
      </div>
      
    </div>
</div>

<script>

  function showQuizCombined(quizId) {
    const quiz = window[`quiz_data_${quizId}`];
    const submissions = window[`quiz_${quizId}`];
    const title = window[`quiz_title_${quizId}`];
    
    document.getElementById('combinedQuizTitle').textContent = `Detail & Hasil: ${title}`;
    
    const detailsBody = document.getElementById('combinedDetailsBody');
    let html = `
      <div style="margin-bottom: 20px; padding: 15px; background: var(--color-bg-surface-alt); border-radius: 8px;">
        <strong>Kode Akses Kuis:</strong> <span style="font-family: monospace; font-size: 1.2em; background: #fff; padding: 2px 8px; border-radius: 4px; margin-left: 10px;">${quiz.code}</span>
      </div>
    `;

    if (quiz.questions && quiz.questions.length > 0) {
      quiz.questions.forEach((q, idx) => {
        html += `
          <div style="border: 1px solid var(--color-border); padding: 15px; border-radius: 8px; margin-bottom: 15px;">
            <div style="font-weight: 600; margin-bottom: 10px;">${idx + 1}. ${q.text} <span style="color: var(--color-text-secondary); font-weight: normal; font-size: 0.9em;">(${q.type})</span></div>
            <ul style="list-style: none; padding-left: 0; margin: 0;">
        `;
        
        if (q.options && q.options.length > 0) {
          q.options.forEach(opt => {
            const isCorrect = opt.is_correct;
            const icon = isCorrect ? '<span style="color: var(--color-success);">✅</span>' : '<span style="color: var(--color-error);">❌</span>';
            const style = isCorrect ? 'font-weight: 600; color: var(--color-success);' : 'color: var(--color-text-secondary);';
            html += `<li style="margin-bottom: 5px; ${style}">${icon} ${opt.text}</li>`;
          });
        } else {
          html += `<li style="color: var(--color-text-secondary); font-style: italic;">Tidak ada opsi (Essay bebas)</li>`;
        }

        html += `</ul></div>`;
      });
    } else {
      html += `<p style="color: var(--color-text-secondary);">Kuis ini belum memiliki soal.</p>`;
    }

    detailsBody.innerHTML = html;

    const tbody = document.getElementById('combinedSubmissionsBody');
    tbody.innerHTML = '';

    let sortedSubmissions = [];
    if (submissions && submissions.length > 0) {
      sortedSubmissions = [...submissions].sort((a, b) => {
        if (b.score !== a.score) {
          return b.score - a.score;
        }
        return new Date(a.created_at) - new Date(b.created_at);
      });
    }

    if (sortedSubmissions.length > 0) {
      sortedSubmissions.forEach((sub, index) => {
        const row = document.createElement('div');
        const date = new Date(sub.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        
        let bgStyle = 'background: var(--bg-surface);';
        let borderStyle = 'border: 1px solid var(--rd-border);';
        let medalIcon = '';
        let rankColor = 'var(--text-secondary)';

        if (index === 0) {
          bgStyle = 'background: linear-gradient(135deg, #FFFDE7, #FFF8E1);';
          borderStyle = 'border: 1px solid #FDE047; border-left: 4px solid #EAB308;';
          medalIcon = '🥇';
          rankColor = '#CA8A04';
        } else if (index === 1) {
          bgStyle = 'background: linear-gradient(135deg, #F3F4F6, #F9FAFB);';
          borderStyle = 'border: 1px solid #E5E7EB; border-left: 4px solid #9CA3AF;';
          medalIcon = '🥈';
          rankColor = '#6B7280';
        } else if (index === 2) {
          bgStyle = 'background: linear-gradient(135deg, #FFF7ED, #FFEDD5);';
          borderStyle = 'border: 1px solid #FED7AA; border-left: 4px solid #F97316;';
          medalIcon = '🥉';
          rankColor = '#C2410C';
        } else {
          borderStyle = 'border: 1px solid var(--rd-border); border-left: 4px solid transparent;';
        }

        row.style.cssText = `display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 8px; ${bgStyle} ${borderStyle}`;
        
        let scoreColor = 'var(--color-error)';
        if (sub.score >= 80) scoreColor = 'var(--color-success)';
        else if (sub.score >= 50) scoreColor = 'var(--color-warning)';

        row.innerHTML = `
          <div style="font-size: 1.2rem; font-weight: 700; color: ${rankColor}; width: 30px; text-align: center;">
            ${medalIcon ? medalIcon : (index + 1)}
          </div>
          <div style="flex: 1; min-width: 0;">
            <div style="font-weight: 600; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${sub.participant_name}</div>
            <div style="font-size: 11px; color: var(--text-tertiary);">${date}</div>
          </div>
          <div style="text-align: right;">
            <div style="font-weight: 700; font-size: 1.1rem; color: ${scoreColor};">${Math.round(sub.score)}</div>
            <div style="font-size: 10px; color: var(--text-muted); font-weight: 600;">SKOR</div>
          </div>
        `;
        tbody.appendChild(row);
      });
    } else {
      tbody.innerHTML = `<div style="text-align: center; color: var(--text-secondary); padding: 30px; background: var(--bg-surface-2); border-radius: 8px;">Belum ada peserta yang mengerjakan kuis ini.</div>`;
    }

    const modal = document.getElementById('combinedModal');
    modal.style.display = 'flex';
    setTimeout(() => {
      modal.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  }

  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }

  async function toggleQuizStatus(code, isActive) {
    try {
      const response = await fetch(`/api/quiz/${code}/toggle-status`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ is_active: isActive })
      });

      const data = await response.json();
      
      if (!response.ok) {
        throw new Error(data.error || 'Gagal mengubah status quiz');
      }

      Swal.fire({
        icon: 'success',
        title: 'Berhasil',
        text: `Status quiz berhasil diubah menjadi ${isActive ? 'Aktif' : 'Tidak Aktif'}.`,
        timer: 1500,
        showConfirmButton: false
      });
    } catch (error) {
      console.error('Error toggling quiz status:', error);
      Swal.fire({
        icon: 'error',
        title: 'Gagal',
        text: error.message
      });
      // Revert the toggle switch visually (requires finding the exact switch, but for simplicity we reload or rely on user to flip it back)
      setTimeout(() => location.reload(), 1500);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const deleteBtns = document.querySelectorAll('.btn-delete-quiz-action');
    deleteBtns.forEach(btn => {
      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        const id = this.getAttribute('data-quiz-id');
        if (!id) return;
        
        try {
          const result = await Swal.fire({
            title: 'Hapus Kuis?',
            text: 'Apakah Anda yakin ingin menghapus kuis ini? Data tidak dapat dikembalikan.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#EF4444',
            cancelButtonColor: '#6B7280',
            confirmButtonText: 'Ya, Hapus!',
            cancelButtonText: 'Batal'
          });

          if (result.isConfirmed) {
            const response = await fetch(`/api/quiz/${id}`, {
              method: 'DELETE'
            });
            
            if (!response.ok) {
              let errorMsg = 'Gagal menghapus kuis';
              try {
                const data = await response.json();
                errorMsg = data.error || errorMsg;
              } catch(err) {}
              throw new Error(errorMsg);
            }

            await Swal.fire({
              icon: 'success',
              title: 'Berhasil',
              text: 'Kuis berhasil dihapus.',
              timer: 1500,
              showConfirmButton: false
            });
            window.location.reload();
          }
        } catch (error) {
          console.error('Delete Quiz Error:', error);
          Swal.fire({
            icon: 'error',
            title: 'Gagal',
            text: error.message || 'Terjadi kesalahan sistem.'
          });
        }
      });
    });
  });
</script>
