<!DOCTYPE html>
<html lang="id" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('partials/head') %>
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="antialiased" style="background-color: var(--color-bg-main); color: var(--color-text-primary);">

    <%- include('partials/navbar') %>

    <main style="padding-top:96px; padding-bottom:64px; min-height:100vh;" class="relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Header -->
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-10 pb-8 border-b border-[var(--color-border)] relative">
                <div class="ambient-mesh mesh-split"></div>
                <div class="gsap-reveal">
                    <div class="mb-2">
                        <span class="text-sm font-semibold tracking-widest text-[var(--color-primary)] uppercase">Katalog Material · PLN</span>
                    </div>
                    <h1 class="text-4xl md:text-5xl font-extrabold brand-font mb-3 tracking-tight leading-tight text-[var(--color-text-primary)]">
                        Material Jaringan PLN
                    </h1>
                    <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed max-w-lg">
                        Klik pada material untuk menampilkan visualisasi 3D interaktif beserta spesifikasi teknis lengkap.
                    </p>
                </div>

                <!-- Search + Filter -->
                <div class="flex items-center gap-3 flex-shrink-0 min-w-[300px] lg:min-w-[380px]">
                    <div class="flex-1 relative">
                        <div class="absolute left-3.5 top-1/2 transform -translate-y-1/2 text-[var(--color-text-muted)] pointer-events-none">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                        </div>
                        <input class="w-full bg-white border border-[var(--color-border)] rounded-xl py-2.5 pl-10 pr-4 text-sm text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] outline-none focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)]/10 transition-all"
                            id="mat-search" type="text" placeholder="Cari material..." oninput="v3MatFilter()">
                    </div>
                    <button type="button" id="mat-sort-btn" onclick="v3ToggleMatSort()"
                        class="flex items-center gap-2 bg-white border border-[var(--color-border)] rounded-xl py-2.5 px-4 text-xs font-semibold text-[var(--color-text-secondary)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition-all cursor-pointer outline-none whitespace-nowrap">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h13M3 12h9M3 18h5"/><path d="M16 18l3 3 3-3M19 9V21"/></svg>
                        <span id="mat-sort-label">A→Z</span>
                    </button>
                </div>
            </div>
            </div>

            <!-- New Filters (Sektor, Tipe, Spesifikasi) -->
            <div class="flex flex-col md:flex-row gap-4 mb-8">
                <div class="flex-1 flex flex-col gap-1.5">
                    <label class="text-[10px] font-bold text-[var(--color-text-muted)] uppercase tracking-wider">Sektor</label>
                    <select id="filter-sektor" class="w-full bg-white border border-[var(--color-border)] rounded-xl py-2.5 px-4 text-sm font-semibold text-[var(--color-text-secondary)] outline-none focus:border-[var(--color-primary)] transition-all cursor-pointer appearance-none" style="background-image: url('data:image/svg+xml;utf8,<svg width=\'24\' height=\'24\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polyline points=\'6 9 12 15 18 9\'></polyline></svg>'); background-repeat: no-repeat; background-position: right 1rem center; background-size: 1em;" onchange="v3MatFilter()">
                        <option value="all">Semua Kategori</option>
                        <% categories.forEach(function(cat) { %>
                            <option value="<%= cat.id %>"><%= cat.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="flex-1 flex flex-col gap-1.5">
                    <label class="text-[10px] font-bold text-[var(--color-text-muted)] uppercase tracking-wider">Tipe</label>
                    <select id="filter-tipe" class="w-full bg-[#f8f9fa] border border-[var(--color-border)] rounded-xl py-2.5 px-4 text-sm font-semibold text-[var(--color-text-muted)] outline-none appearance-none" style="background-image: url('data:image/svg+xml;utf8,<svg width=\'24\' height=\'24\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'#adb5bd\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polyline points=\'6 9 12 15 18 9\'></polyline></svg>'); background-repeat: no-repeat; background-position: right 1rem center; background-size: 1em;" disabled>
                        <option value="all">Semua Tipe</option>
                    </select>
                </div>
                <div class="flex-1 flex flex-col gap-1.5">
                    <label class="text-[10px] font-bold text-[var(--color-text-muted)] uppercase tracking-wider">Spesifikasi</label>
                    <select id="filter-spesifikasi" class="w-full bg-[#f8f9fa] border border-[var(--color-border)] rounded-xl py-2.5 px-4 text-sm font-semibold text-[var(--color-text-muted)] outline-none appearance-none" style="background-image: url('data:image/svg+xml;utf8,<svg width=\'24\' height=\'24\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'#adb5bd\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polyline points=\'6 9 12 15 18 9\'></polyline></svg>'); background-repeat: no-repeat; background-position: right 1rem center; background-size: 1em;" disabled>
                        <option value="all">Semua Spesifikasi</option>
                    </select>
                </div>
            </div>

            <!-- Grid -->
            <% const validMaterials = materialData.filter(function(m) { return m.name && m.name.trim() !== ''; }); %>
            <div id="material-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 gsap-stagger-container">
                <% if (validMaterials.length === 0) { %>
                <div class="col-span-full flex flex-col items-center justify-center py-20 gap-4">
                    <div class="w-16 h-16 rounded-lg bg-[var(--color-bg-surface-alt)] flex items-center justify-center">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-muted)" stroke-width="1.5"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                    </div>
                    <span class="text-sm text-[var(--color-text-muted)]">Belum ada material yang tersedia.</span>
                </div>
                <% } %>

                <% validMaterials.forEach((mat, i) => { %>
                <div class="gsap-stagger-item mat-card-item" data-category="<%= mat.category %>">
                    <div class="card-elevated overflow-hidden h-full cursor-pointer group flex flex-col" data-id="<%= mat.id %>">
                        <!-- Image -->
                        <div class="aspect-[16/10] relative overflow-hidden bg-[rgba(0,0,0,0.02)]">
                            <% if (mat.image) { %>
                                <img src="<%= mat.image %>" alt="<%= mat.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" onerror="this.onerror=null; this.outerHTML=`<div class='w-full h-full flex flex-col items-center justify-center gap-2 bg-[rgba(0,0,0,0.02)]'><svg width='32' height='32' viewBox='0 0 24 24' fill='none' stroke='var(--color-accent)' stroke-width='1' opacity='0.3'><path d='M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4'/></svg><span class='text-[9px] font-bold tracking-[0.1em] text-[var(--color-text-muted)] uppercase'>Material</span></div>`;">
                            <% } else { %>
                                <div class="w-full h-full flex flex-col items-center justify-center gap-2">
                                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="<%= i % 2 === 0 ? 'var(--color-accent)' : 'var(--color-cyan)' %>" stroke-width="1" opacity="0.3">
                                        <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                                    </svg>
                                    <span class="text-[9px] font-bold tracking-[0.1em] text-[var(--color-text-muted)] uppercase">Material</span>
                                </div>
                            <% } %>
                            <!-- Category badge -->
                            <div class="absolute top-3 right-3 z-20">
                                <span class="max-w-[120px] truncate inline-block align-bottom text-[9px] font-bold uppercase tracking-[0.08em] px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-sm text-[var(--color-text-secondary)] border border-[var(--color-border)]" title="<%= mat.categoryLabel %>">
                                    <%= mat.categoryLabel %>
                                </span>
                            </div>
                        </div>

                        <!-- Body -->
                        <div class="p-5 flex flex-col flex-grow">
                            <h3 class="v3-card-title text-base font-bold text-[var(--color-text-primary)] brand-font leading-snug mb-1.5 group-hover:text-[var(--color-primary)] transition-colors"><%= mat.name %></h3>
                            <div class="relative flex-grow mb-4">
                                <p class="text-xs leading-relaxed line-clamp-2 opacity-0 pointer-events-none select-none" aria-hidden="true">
                                    <%= mat.description || 'Deskripsi belum tersedia.' %><br>&nbsp;<br>&nbsp;
                                </p>
                                <p class="absolute inset-0 text-sm text-[var(--color-text-secondary)] leading-relaxed overflow-hidden">
                                    <%= mat.description || 'Deskripsi belum tersedia.' %>
                                </p>
                            </div>
                            <div class="mt-auto">
                                <div class="h-px bg-[var(--color-border-light)] mb-4"></div>
                                <div class="flex items-center justify-between gap-3">
                                    <div class="flex gap-4 min-w-0 flex-1">
                                        <div class="flex flex-col min-w-0 flex-1 justify-center">
                                            <span class="text-[9px] font-bold tracking-[0.1em] text-[var(--color-text-muted)] uppercase truncate">Kategori</span>
                                            <span class="text-sm font-bold text-[var(--color-accent)] brand-font truncate" title="<%= mat.categoryLabel %>"><%= mat.categoryLabel %></span>
                                        </div>
                                        <div class="w-px bg-[var(--color-border-light)] shrink-0"></div>
                                        <div class="flex flex-col shrink-0 justify-center">
                                            <span class="text-[9px] font-bold tracking-[0.1em] text-[var(--color-text-muted)] uppercase truncate">Kode</span>
                                            <span class="text-sm font-bold text-[var(--color-cyan)] brand-font truncate" title="<%= mat.code || '—' %>"><%= mat.code || '—' %></span>
                                        </div>
                                    </div>
                                    <div class="w-9 h-9 shrink-0 rounded-xl bg-[var(--color-primary)]/8 flex items-center justify-center text-[var(--color-primary)] group-hover:bg-[var(--color-primary)] group-hover:text-white transition-all duration-300 group-hover:rotate-[-45deg] group-hover:scale-110">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>

            <!-- No results -->
            <div id="no-results" class="hidden flex-col items-center justify-center py-20 gap-4" style="display:none;">
                <div class="w-16 h-16 rounded-lg bg-[var(--color-bg-surface-alt)] flex items-center justify-center">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-muted)" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </div>
                <span class="text-sm text-[var(--color-text-muted)]">Tidak ada material untuk kategori ini.</span>
            </div>
        </div>
    </main>

    <%- include('partials/catalog-modal-material') %>

    <script id="material-data" type="text/template">
        <%- JSON.stringify(materialData) %>
    </script>
    <script>
        var __MATERIAL_DATA__ = JSON.parse(document.getElementById('material-data').textContent);
    </script>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
    <script src="/js/catalog-modal.js"></script>
    <script src="/js/material.js?v=2"></script>
    <script>
        var _matSort = 'none';
        var _matActiveFilter = 'all';
        (function() { var items = document.getElementById('material-grid').querySelectorAll('.mat-card-item'); items.forEach(function(el, i) { el.dataset.origIdx = i; }); })();

        function v3ToggleMatSort() {
            var lbl = document.getElementById('mat-sort-label');
            if (_matSort === 'none' || _matSort === 'desc') { _matSort = 'asc'; lbl.textContent = 'A→Z'; } else { _matSort = 'desc'; lbl.textContent = 'Z→A'; }
            v3SortMatGrid();
        }
        function v3SortMatGrid() {
            var grid = document.getElementById('material-grid');
            var items = Array.from(grid.querySelectorAll('.mat-card-item'));
            if (_matSort === 'none') { items.sort(function(a, b) { return a.dataset.origIdx - b.dataset.origIdx; }); }
            else { items.sort(function(a, b) { var na = (a.querySelector('.v3-card-title') || {}).textContent || ''; var nb = (b.querySelector('.v3-card-title') || {}).textContent || ''; return _matSort === 'asc' ? na.localeCompare(nb, 'id') : nb.localeCompare(na, 'id'); }); }
            items.forEach(function(el) { grid.appendChild(el); });
        }
        function v3MatFilter() {
            var q = (document.getElementById('mat-search').value || '').toLowerCase().trim();
            var selSektor = document.getElementById('filter-sektor');
            var sektorVal = selSektor ? selSektor.value : 'all';
            var visible = 0;
            document.querySelectorAll('.mat-card-item').forEach(function(item) {
                var matchCat = sektorVal === 'all' || item.dataset.category === sektorVal;
                var nameEl = item.querySelector('.v3-card-title');
                var name = nameEl ? nameEl.textContent.toLowerCase() : '';
                var matchQ = q === '' || name.includes(q);
                var show = matchCat && matchQ;
                item.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            var noResults = document.getElementById('no-results');
            if (noResults) { noResults.style.display = visible === 0 ? 'flex' : 'none'; noResults.classList.toggle('hidden', visible > 0); }
        }
        // Hover 3D badge
        document.querySelectorAll('.card-elevated[data-id]').forEach(function(card) {
            var badge = card.querySelector('.v3-3d-badge');
            if (!badge) return;
            card.addEventListener('mouseenter', function() { badge.style.opacity = '1'; });
            card.addEventListener('mouseleave', function() { badge.style.opacity = '0'; });
        });
        // GSAP
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
                gsap.registerPlugin(ScrollTrigger);
                gsap.to('.gsap-reveal', { y: 0, opacity: 1, duration: 1, stagger: 0.15, ease: 'power3.out', delay: 0.1 });
                gsap.from('.gsap-stagger-item', { scrollTrigger: { trigger: '#material-grid', start: 'top 85%' }, y: 50, opacity: 0, duration: 0.8, stagger: 0.08, ease: 'power3.out' });
            }
        });
    </script>
</body>
</html>