<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <%- include('../partials/head') %>
  <style>
    body { background: #f3f4f6; }
    .box-container {
      max-width: 600px;
      margin: 80px auto;
      background: white;
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      text-align: center;
    }
    .box-title {
      font-size: 2rem;
      font-weight: 800;
      color: var(--color-primary);
      margin-bottom: 30px;
    }
    .btn-action {
      display: block;
      width: 100%;
      padding: 15px;
      margin-bottom: 15px;
      font-size: 1.2rem;
      font-weight: 700;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-create {
      background: var(--color-primary);
      color: white;
    }
    .btn-create:hover { background: #004b8a; transform: translateY(-2px); }
    .btn-join {
      background: #e5e7eb;
      color: #374151;
    }
    .btn-join:hover { background: #d1d5db; transform: translateY(-2px); }
  </style>
</head>
<body>
  <%- include('../partials/navbar') %>
  
  <div class="box-container">
    <div style="font-size: 3rem; margin-bottom: 10px;">📦⚡</div>
    <h1 class="box-title">WHATS IN THE BOX</h1>
    <p style="margin-bottom: 30px; color: #666;">Mainkan tebak kata seru bertema kelistrikan!</p>
    
    <% if (typeof userRole !== 'undefined' && userRole && (userRole.toUpperCase() === 'INSTRUKTUR' || userRole.toUpperCase() === 'ADMIN')) { %>
    <a href="/box/create" style="text-decoration: none;">
      <button class="btn-action btn-create">Buat Game (Instruktur)</button>
    </a>
    <% } %>
    <a href="/box/join" style="text-decoration: none;">
      <button class="btn-action btn-join">Join Game (Peserta)</button>
    </a>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
