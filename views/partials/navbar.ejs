<!-- ═══ AWWWARDS-LEVEL NAVBAR — JALA (Refined) ═══ -->
<%
  // Determine user role from session (set by optionalAuth middleware via res.locals)
  const _role = (typeof userRole !== 'undefined' && userRole) ? userRole : null;
  const _isPeserta = !_role || _role === 'Peserta';
  const _isUPDL = _role === 'UPDL';
  const _isInstruktur = _role === 'Instruktur';

  // Build pembelajaran sub-items based on role
  let pembelajaranSubs = [];
  if (_isUPDL) {
    pembelajaranSubs = [
      { href: '/pembelajaran/katalog', label: 'Katalog Instruktur' },
      { href: '/pembelajaran/jadwal', label: 'Jadwal Instruktur' },
    ];
  } else if (_isInstruktur) {
    pembelajaranSubs = [
      { href: '/pembelajaran/katalog', label: 'Katalog Instruktur' },
      { href: '/pembelajaran/jadwal', label: 'Jadwal Instruktur' },
      { href: '/quiz', label: 'Quiz' },
    ];
  }

  const navItems = [
    { href: '/', label: 'Beranda', key: 'home', desc: 'Halaman utama platform' },
    { href: '/tools', label: 'Peralatan', key: 'tools', desc: 'Katalog peralatan 3D' },
    { href: '/ModulKonstruksi', label: 'Konstruksi', key: 'konstruksi', desc: 'Modul pembelajaran konstruksi' },
    { href: '/material', label: 'Material', key: 'material', desc: 'Database material kelistrikan' },
    // Pembelajaran: if Peserta/guest → direct link to quiz; otherwise dropdown built via subs
    {
      href: _isPeserta ? '/quiz' : '#',
      label: 'Pembelajaran',
      key: 'pembelajaran',
      desc: 'Pembelajaran & Kuis interaktif',
      subs: _isPeserta ? [] : pembelajaranSubs
    }
  ];

  const current = typeof currentPage !== 'undefined' ? currentPage : (typeof isLanding !== 'undefined' && isLanding ? 'home' : '');
%>

<!-- ═══ FLOATING PILL NAVBAR ═══ -->
<div id="jl-nav-wrap" class="jl-nav-wrap">
  <nav id="jl-navbar" class="jl-navbar">

    <!-- Scroll Progress Bar (inside pill) -->
    <div class="jl-nav-progress-track">
      <div id="jl-nav-progress" class="jl-nav-progress-bar"></div>
    </div>

    <!-- Brand -->
    <a href="/listrikpedia" class="jl-brand" data-magnetic>
      <span class="jl-brand-text" style="font-weight: 900; font-size: 1.25rem; letter-spacing: 0.05em; color: var(--color-text-primary);">Listrik<span style="color: #3b608a;">Pedia</span></span>
    </a>

    <!-- Divider (desktop) -->
    <div class="jl-nav-divider"></div>

    <!-- Desktop Links -->
    <div class="jl-nav-links">
      <!-- Sliding pill background -->
      <div id="jl-link-pill" class="jl-link-pill"></div>

      <% navItems.forEach((item, idx) => { %>
        <% if (item.subs && item.subs.length > 0) { %>
          <div class="jl-nav-dropdown-wrap" data-magnetic>
            <a href="#"
               class="jl-nav-link <%= current === item.key ? 'is-active' : '' %>"
               data-idx="<%= idx %>">
              <span class="jl-nav-link-text"><%= item.label %></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="jl-nav-dropdown-icon">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <div class="jl-nav-dropdown-menu">
              <% item.subs.forEach(sub => { %>
                <a href="<%= sub.href %>" class="jl-nav-dropdown-item"><%= sub.label %></a>
              <% }) %>
            </div>
          </div>
        <% } else { %>
          <a href="<%= item.href %>"
             class="jl-nav-link <%= current === item.key ? 'is-active' : '' %>"
             data-idx="<%= idx %>"
             data-magnetic>
            <span class="jl-nav-link-text"><%= item.label %></span>
          </a>
        <% } %>
      <% }); %>
    </div>

    <!-- Right Section -->
    <div class="jl-nav-right">
      <!-- Hamburger Toggle (mobile only) -->

      <!-- Hamburger Toggle (mobile only) -->
      <button id="jl-menu-toggle" class="jl-menu-toggle" aria-label="Menu">
        <div class="jl-toggle-inner">
          <div class="jl-toggle-icon">
            <span></span>
            <span></span>
          </div>
        </div>
      </button>
    </div>
  </nav>
</div>

<!-- ═══ FULLSCREEN OVERLAY MENU ═══ -->
<div id="jl-overlay" class="jl-overlay">

  <!-- Background layers -->
  <div class="jl-overlay-bg">
    <div class="jl-overlay-bg-layer" style="--delay: 0;"></div>
    <div class="jl-overlay-bg-layer" style="--delay: 1;"></div>
    <div class="jl-overlay-bg-layer" style="--delay: 2;"></div>
  </div>

  <!-- Overlay Content -->
  <div class="jl-overlay-content">

    <!-- Left: Navigation -->
    <div class="jl-overlay-nav">
      <p class="jl-overlay-label">Navigasi</p>

      <% navItems.forEach((item, idx) => { %>
        <% if (item.subs && item.subs.length > 0) { %>
          <div class="jl-overlay-dropdown-wrap">
            <a href="#"
               class="jl-overlay-link jl-overlay-dropdown-toggle <%= current === item.key ? 'is-active' : '' %>"
               data-desc="<%= item.desc %>"
               style="--i: <%= idx %>;">
              <span class="jl-ol-num">0<%= idx + 1 %></span>
              <span class="jl-ol-text-wrap">
                <span class="jl-ol-text"><%= item.label %></span>
              </span>
              <span class="jl-ol-desc"><%= item.desc %></span>
              <span class="jl-ol-arrow jl-arrow-down">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
            <div class="jl-overlay-dropdown-menu">
              <% item.subs.forEach(sub => { %>
                <a href="<%= sub.href %>" class="jl-overlay-sublink"><%= sub.label %></a>
              <% }) %>
            </div>
          </div>
        <% } else { %>
          <a href="<%= item.href %>"
             class="jl-overlay-link <%= current === item.key ? 'is-active' : '' %>"
             data-desc="<%= item.desc %>"
             style="--i: <%= idx %>;">
            <span class="jl-ol-num">0<%= idx + 1 %></span>
            <span class="jl-ol-text-wrap">
              <span class="jl-ol-text"><%= item.label %></span>
            </span>
            <span class="jl-ol-desc"><%= item.desc %></span>
            <span class="jl-ol-arrow">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        <% } %>
      <% }); %>
    </div>

    <!-- Right: Info Column -->
    <div class="jl-overlay-info">
      <div class="jl-overlay-info-block">
        <p class="jl-overlay-label">Platform</p>
        <p class="jl-overlay-desc">
          Platform pembelajaran kelistrikan berbasis 3D interaktif untuk karyawan & teknisi PT PLN (Persero).
        </p>
      </div>

      <div class="jl-overlay-info-block">
        <p class="jl-overlay-label">Kontak</p>
        <a href="mailto:pusdiklat@pln.co.id" class="jl-overlay-contact">pusdiklat@pln.co.id</a>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="jl-overlay-footer">
    <span>&copy; 2026 PT PLN (Persero)</span>
    <span>ListrikPedia — Ensiklopedia Kelistrikan</span>
  </div>
</div>
