<!DOCTYPE html>
<html lang="id" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head') %>
</head>
<body class="antialiased" style="background-color: var(--color-bg-main); color: var(--color-text-primary);">
    <%- include('../partials/navbar') %>

<div class="jl-container px-6 md:px-12" style="padding-top: 120px; min-height: 80vh;">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <h1 class="text-3xl font-bold text-[var(--color-text-primary)]">Katalog Instruktur</h1>
    
    <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
      <div class="relative w-full sm:w-64 lg:w-80">
        <input type="text" id="searchInput" onkeyup="searchTable()" class="w-full pl-10 pr-4 py-2.5 bg-white border border-[var(--color-border)] rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all shadow-sm text-[var(--color-text-primary)]" placeholder="Cari nama, NIP, keahlian...">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
        </svg>
      </div>

      <% if (sessionUser && sessionUser.role === 'UPDL') { %>
        <button onclick="openAddModal()" class="px-5 py-2.5 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm flex items-center justify-center gap-2 whitespace-nowrap w-full sm:w-auto">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg>
          Tambah Instruktur
        </button>
      <% } %>
    </div>
  </div>

  <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-[var(--color-bg-hover)] border-b border-[var(--color-border)]">
            <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">No</th>
            <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">NIP</th>
            <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">Nama Instruktur</th>
            <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">Status</th>
            <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">Keahlian</th>
            <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">Unit</th>
            <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">Total JP Bulan Ini</th>
            <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">Total JP 5 Tahun</th>
            <% if (sessionUser && sessionUser.role === 'UPDL') { %>
              <th class="p-4 font-semibold text-[var(--color-text-muted)] text-sm">Aksi</th>
            <% } %>
          </tr>
        </thead>
        <tbody id="katalog-tbody">
          <% if (katalogData && katalogData.length > 0) { %>
            <% katalogData.forEach((item, index) => { %>
              <tr class="katalog-row border-b border-[var(--color-border)] hover:bg-[var(--color-bg-hover)] transition-colors">
                <td class="p-4 text-[var(--color-text-primary)]"><%= index + 1 %></td>
                <td class="p-4 text-[var(--color-text-primary)]"><%= item.nip %></td>
                <td class="p-4 font-medium text-[var(--color-brand-primary)]"><%= item.nama_instruktur %></td>
                <td class="p-4">
                  <% 
                    let statusClass = 'bg-gray-100 text-gray-700';
                    if (item.status === 'Instruktur Tetap') statusClass = 'bg-green-100 text-green-700';
                    else if (item.status === 'Instruktur Tidak Tetap') statusClass = 'bg-yellow-100 text-yellow-700';
                    else if (item.status === 'Instruktur Eksternal') statusClass = 'bg-blue-100 text-blue-700';
                  %>
                  <span class="px-2.5 py-1 rounded-full text-xs font-medium <%= statusClass %>">
                    <%= item.status || 'Instruktur Tetap' %>
                  </span>
                </td>
                <td class="p-4 text-[var(--color-text-secondary)]"><%= item.keahlian || '-' %></td>
                <td class="p-4 text-[var(--color-text-secondary)]"><%= item.unit || '-' %></td>
                <td class="p-4 text-[var(--color-text-primary)]"><%= item.total_jp_bulan_ini || 0 %></td>
                <td class="p-4 text-[var(--color-text-primary)]"><%= item.total_jp_5_tahun || 0 %></td>
                <% if (sessionUser && sessionUser.role === 'UPDL') { %>
                  <td class="p-4">
                    <div class="flex gap-2">
                      <button class="px-3 py-1.5 bg-blue-50 text-blue-600 border border-blue-200 rounded-md hover:bg-blue-600 hover:text-white transition-colors text-sm font-medium btn-edit"
                        data-id="<%= item.id %>"
                        data-nip="<%= item.nip %>"
                        data-nama="<%= item.nama_instruktur %>"
                        data-status="<%= item.status %>"
                        data-keahlian="<%= item.keahlian || '' %>"
                        data-unit="<%= item.unit || '' %>">Edit</button>
                      <button class="px-3 py-1.5 bg-red-50 text-red-600 border border-red-200 rounded-md hover:bg-red-600 hover:text-white transition-colors text-sm font-medium btn-hapus"
                        data-id="<%= item.id %>">Hapus</button>
                    </div>
                  </td>
                <% } %>
              </tr>
            <% }); %>
            <tr id="no-results-row" style="display: none;">
              <td colspan="<%= (sessionUser && sessionUser.role === 'UPDL') ? 9 : 8 %>" class="p-8 text-center text-[var(--color-text-muted)]">
                Pencarian tidak ditemukan.
              </td>
            </tr>
          <% } else { %>
            <tr>
              <td colspan="<%= (sessionUser && sessionUser.role === 'UPDL') ? 9 : 8 %>" class="p-8 text-center text-[var(--color-text-muted)]">
                Belum ada data katalog instruktur.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (sessionUser && sessionUser.role === 'UPDL') { %>
  <!-- Modal Tambah/Edit Katalog -->
  <div id="katalogModal" class="fixed inset-0 z-[200] hidden items-center justify-center bg-black/50 backdrop-blur-sm transition-opacity">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform" id="katalogModalCard">
      <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
        <h3 id="modalTitle" class="text-lg font-bold text-gray-800">Tambah Instruktur</h3>
        <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
        </button>
      </div>
      <form id="katalogForm" onsubmit="submitForm(event)">
        <div class="px-6 py-4 space-y-4">
          <input type="hidden" id="instrukturId">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">NIP</label>
            <input type="text" id="nip" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="Masukkan NIP">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nama Instruktur</label>
            <input type="text" id="nama" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
            <select id="status" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all bg-white">
              <option value="Instruktur Tetap">Instruktur Tetap</option>
              <option value="Instruktur Tidak Tetap">Instruktur Tidak Tetap</option>
              <option value="Instruktur Eksternal">Instruktur Eksternal</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Keahlian</label>
            <input type="text" id="keahlian" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="Contoh: Teknik Distribusi, Proteksi Jaringan">
            <p class="text-xs text-gray-400 mt-1">Pisahkan dengan koma jika lebih dari satu keahlian</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Unit</label>
            <input type="text" id="unit" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="Contoh: UPDL Padang, PLN Pusdiklat">
          </div>
        </div>
        <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3 bg-gray-50/50">
          <button type="button" onclick="closeModal()" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">Batal</button>
          <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors shadow-sm">Simpan</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const modal = document.getElementById('katalogModal');
    const modalCard = document.getElementById('katalogModalCard');
    const API_URL = '/api/pembelajaran/katalog-instruktur';

    // Gunakan event delegation + data attributes agar aman dengan koma/karakter khusus
    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('katalog-tbody').addEventListener('click', (e) => {
        const editBtn = e.target.closest('.btn-edit');
        const hapusBtn = e.target.closest('.btn-hapus');
        if (editBtn) {
          const d = editBtn.dataset;
          editData(d.id, d.nip, d.nama, d.status, d.keahlian, d.unit);
        }
        if (hapusBtn) {
          deleteData(hapusBtn.dataset.id);
        }
      });
    });

    function openAddModal() {
      document.getElementById('modalTitle').textContent = 'Tambah Instruktur';
      document.getElementById('katalogForm').reset();
      document.getElementById('instrukturId').value = '';
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => modalCard.classList.remove('scale-95'), 10);
    }

    function editData(id, nip, nama, status, keahlian, unit) {
      document.getElementById('modalTitle').textContent = 'Edit Instruktur';
      document.getElementById('instrukturId').value = id;
      document.getElementById('nip').value = nip;
      document.getElementById('nama').value = nama;
      document.getElementById('status').value = status;
      document.getElementById('keahlian').value = keahlian || '';
      document.getElementById('unit').value = unit || '';
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => modalCard.classList.remove('scale-95'), 10);
    }

    function closeModal() {
      modalCard.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
      }, 200);
    }

    async function submitForm(e) {
      e.preventDefault();
      const id = document.getElementById('instrukturId').value;
      const payload = {
        nip: document.getElementById('nip').value.trim(),
        nama_instruktur: document.getElementById('nama').value,
        status: document.getElementById('status').value,
        keahlian: document.getElementById('keahlian').value,
        unit: document.getElementById('unit').value
      };

      try {
        const res = await fetch(id ? `${API_URL}/${id}` : API_URL, {
          method: id ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert('Gagal: ' + (err.error || 'Terjadi kesalahan') + (err.detail ? '\n\nDetail: ' + err.detail : ''));
        }
      } catch (error) {
        alert('Gagal menghubungi server');
      }
    }

    async function deleteData(id) {
      if (!confirm('Apakah Anda yakin ingin menghapus instruktur ini?')) return;
      try {
        const res = await fetch(`${API_URL}/${id}`, {
          method: 'DELETE',
          credentials: 'include'
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Gagal menghapus data');
        }
      } catch (error) {
        alert('Gagal menghubungi server');
      }
    }
  </script>
<% } %>

<script>
  function searchTable() {
    const input = document.getElementById('searchInput');
    const filter = input.value.toLowerCase();
    const tbody = document.getElementById('katalog-tbody');
    if (!tbody) return;
    
    const rows = tbody.getElementsByClassName('katalog-row');
    let visibleCount = 0;

    for (let i = 0; i < rows.length; i++) {
      // NIP: index 1, Nama: index 2, Keahlian: index 4
      const nipCell = rows[i].getElementsByTagName('td')[1];
      const namaCell = rows[i].getElementsByTagName('td')[2];
      const keahlianCell = rows[i].getElementsByTagName('td')[4];
      
      if (nipCell && namaCell && keahlianCell) {
        const nip = nipCell.textContent || nipCell.innerText;
        const nama = namaCell.textContent || namaCell.innerText;
        const keahlian = keahlianCell.textContent || keahlianCell.innerText;
        
        if (nip.toLowerCase().indexOf(filter) > -1 || 
            nama.toLowerCase().indexOf(filter) > -1 || 
            keahlian.toLowerCase().indexOf(filter) > -1) {
          rows[i].style.display = "";
          visibleCount++;
        } else {
          rows[i].style.display = "none";
        }
      }
    }
    
    const noResultsRow = document.getElementById('no-results-row');
    if (noResultsRow) {
      if (visibleCount === 0 && rows.length > 0) {
        noResultsRow.style.display = "";
      } else {
        noResultsRow.style.display = "none";
      }
    }
  }
</script>

<%- include('../partials/footer') %>
</body>
</html>
